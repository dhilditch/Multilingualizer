# Google service-account JSON. Add the service-account email as a user in
# Search Console and GA4 before running the collectors.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-service-account.json
GSC_SITE_URL=sc-domain:multilingualizer.com
GA4_PROPERTY_ID=

# WordPress application password. Keep the spaces in the generated password.
WP_SITE_URL=https://www.multilingualizer.com
WP_USERNAME=
WP_APPLICATION_PASSWORD=
